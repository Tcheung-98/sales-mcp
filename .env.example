# Copy to .env for local dev: cp .env.example .env

# Azure AD / Microsoft Graph (SharePoint ingest + optional live fetch)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=

# AWS — S3 bucket for templates, GTM xlsx, inventory xlsx, product decks, snapshots
S3_SNAPSHOT_BUCKET=fortune-sales-mcp-dev-artifacts

# MCP auth (Cowork / Prodie → this server)
MCP_SHARED_SECRET=

# Anthropic (local dev; prod uses Secrets Manager)
ANTHROPIC_API_KEY=

# --- Ideation + Creation data (PI-2759 I1) — see local/.../I1-DATA-SOURCES.md ---

# Fortune_AITool_GTM_Database.xlsx — Product Tags, Audience Data, GTM Tags, Product Category
GTM_DATABASE_KEY=templates/Fortune_AITool_GTM_Database.xlsx

# Fortune Inventory & Reservation Calendar 2026 Final — Products, Pricing, Benchmarks
INVENTORY_CALENDAR_KEY=templates/Fortune_Inventory_Reservation_Calendar_2026_Final.xlsx

# Hunter product decks referenced by Product Tags "Deck Path"
PRODUCT_DECKS_PREFIX=product-decks/

# FortuneAI Creation spine
FORTUNEAI_TEMPLATE_KEY=templates/FortuneAI_DeckTemplate.pptx

# Legacy RAG generator rate card (CSV); not Logic Guide pricing
# RATE_SHEET_KEY=

# Other template keys
RULEBOOK_KEY=templates/rulebook.docx
PPTX_BLANK_DECK_KEY=templates/blank.pptx

# Optional: extra hosts allowed for build_deck template_url
# TEMPLATE_URL_ALLOWED_HOSTS=
