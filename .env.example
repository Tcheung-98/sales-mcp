# Copy to .env for local dev: cp .env.example .env

# AWS — S3 bucket for templates, GTM xlsx, inventory xlsx, product decks
S3_SNAPSHOT_BUCKET=fortune-sales-mcp-dev-artifacts

# MCP auth (Cowork / Prodie → this server)
MCP_SHARED_SECRET=

# Anthropic (local dev; prod uses Secrets Manager)
ANTHROPIC_API_KEY=

# --- Ideation + Creation data (PI-2759 I1) — see local/.../I1-DATA-SOURCES.md ---

# Fortune_AITool_GTM_Database.xlsx — Product Tags, Audience Data, GTM Tags, Product Category
GTM_DATABASE_KEY=templates/Fortune_AITool_GTM_Database.xlsx

# Fortune Inventory & Reservation Calendar 2026 Final — Products, Pricing, Benchmarks
INVENTORY_CALENDAR_KEY=templates/Fortune_Inventory_Reservation_Calendar_2026_Final.xlsx

# Hunter product decks referenced by Product Tags "Deck Path"
PRODUCT_DECKS_PREFIX=product-decks/

# FortuneAI Creation spine
FORTUNEAI_TEMPLATE_KEY=templates/FortuneAI_DeckTemplate.pptx

# Optional: extra hosts allowed for build_deck template_url
# TEMPLATE_URL_ALLOWED_HOSTS=

# --- Headless deck QA gate — see docs/DECK-QA-ARCHITECTURE.md §8 ---
# QA is ALWAYS ON: every build_deck runs B2→B3→B4. The bypasses below are for
# local dev and emergency ops only — never set them in production.

# Emergency/local bypass: 1/true/yes skips the entire QA rail (deck ships with a warning)
# DECK_QA_DISABLED=

# Local-dev bypass: 1/true/yes runs B2+B3 but skips the B4 vision pass (no Cursor key needed)
# DECK_QA_SKIP_VISION=

# Wall-clock budget for review package + deterministic QA + Cursor pass.
# On overrun build_deck fails loud (status: error with qa_report) — no unreviewed deck ships.
DECK_QA_TIMEOUT_S=600

# Cursor SDK auth for the B4 vision pass — required in production
CURSOR_API_KEY=
